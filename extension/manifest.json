{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.4.2",
  "homepage_url": "https://github.com/tyvor/fireup-optimize",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "menus",
    "sessions"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "policy.js",
      "transfer.js",
      "working-set.js",
      "engine.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "FireUp",
    "default_popup": "popup.html",
    "default_icon": "icons/fireup.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/fireup.svg",
    "96": "icons/fireup.svg"
  },
  "commands": {
    "sleep-extra": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_unloadCommand__"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; img-src 'self' data: moz-annotation:; connect-src 'none'; style-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "fireup@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "default_locale": "en"
}
